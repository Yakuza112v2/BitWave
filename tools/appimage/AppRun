#!/bin/sh
# AppImage entry point. The whole Nuitka standalone tree lives at
# usr/lib/bitwave inside the mounted image; exec the real binary so BitWave is
# the process (signal handling, /proc/self/exe, taskbar identity all sane).
HERE="$(dirname "$(readlink -f "$0")")"
exec "$HERE/usr/lib/bitwave/BitWave" "$@"
